# Copy to .env for local runs. Never commit .env.
# On GitHub these two live in Settings -> Secrets and variables -> Actions.

# From @BotFather. If it ever leaks, run /revoke there and put the new one here.
TELEGRAM_TOKEN=

# Comma separated Telegram user ids allowed to use the bot.
# Leave empty for the first run, send /id to the bot, then paste the number here.
# Example: ALLOWED_USER_IDS=123456789
ALLOWED_USER_IDS=
